// AM Flipbook database: MongoDB (Atlas) through Prisma.
// "Enum" columns are plain strings validated with zod in the server.
//
// MongoDB has no migrations: `npm run db:migrate` runs `prisma db push`,
// which creates the collections and indexes below and is safe to re-run.
//
// Note for queries: in MongoDB an optional field can be null OR missing.
// Prisma's `{ field: null }` matches only stored nulls, so code that filters
// on "no value" uses `isNull("field")` from src/db.ts, which matches both.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model Admin {
  id           String     @id @default(auto()) @map("_id") @db.ObjectId
  username     String     @unique
  passwordHash String
  /// Bumped on password change so older sessions stop working.
  tokenVersion Int        @default(0)
  lastLoginAt  DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  auditLogs    AuditLog[]
  decisions    Request[]
}

model Customer {
  id               String     @id @default(auto()) @map("_id") @db.ObjectId
  username         String     @unique
  passwordHash     String
  name             String
  /// Digits only, with country code, e.g. 919876543210
  whatsapp         String
  email            String?
  planId           String?    @db.ObjectId
  plan             Plan?      @relation(fields: [planId], references: [id])
  /// Snapshot of the plan terms at approval time, so editing a plan later
  /// does not change what an existing customer paid for.
  planName         String?
  /// none | active | expired (kept up to date by the daily job; checks use planExpiresAt)
  planStatus       String     @default("none")
  planStartsAt     DateTime?
  planExpiresAt    DateTime?
  /// null = unlimited
  downloadsAllowed Int?
  downloadsUsed    Int        @default(0)
  watermark        Boolean    @default(false)
  shareLinkDays    Int        @default(7)
  disabled         Boolean    @default(false)
  tokenVersion     Int        @default(0)
  lastLoginAt      DateTime?
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt
  flipbooks        Flipbook[]
  requests         Request[]
  downloads        DownloadEvent[]

  @@index([whatsapp])
  @@index([planId])
}

model Plan {
  id            String     @id @default(auto()) @map("_id") @db.ObjectId
  /// Stable identifier used in URLs: instant | day | week | month
  code          String     @unique
  name          String
  tagline       String     @default("")
  /// subscription | instant
  type          String
  /// Whole rupees
  price         Int
  /// null = unlimited
  downloadLimit Int?
  /// Subscription length, or how long the one-time link works for instant plans
  validityHours Int
  shareLinkDays Int
  watermark     Boolean    @default(false)
  highlight     Boolean    @default(false)
  active        Boolean    @default(true)
  sortOrder     Int        @default(0)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  customers     Customer[]
  requests      Request[]
}

/// A purchase request. Today payment happens on WhatsApp and an admin
/// approves it; a payment gateway would fill paymentMethod/paymentRef and
/// approve through the same fulfilRequest() service.
model Request {
  id            String         @id @default(auto()) @map("_id") @db.ObjectId
  code          String         @unique
  /// new | renewal | instant
  kind          String
  /// pending | approved | rejected
  status        String         @default("pending")
  planId        String         @db.ObjectId
  plan          Plan           @relation(fields: [planId], references: [id])
  planName      String
  price         Int
  name          String
  whatsapp      String
  email         String?
  customerId    String?        @db.ObjectId
  customer      Customer?      @relation(fields: [customerId], references: [id])
  flipbookId    String?
  flipbook      Flipbook?      @relation(fields: [flipbookId], references: [id], onDelete: SetNull)
  /// whatsapp_manual today; e.g. razorpay later
  paymentMethod String         @default("whatsapp_manual")
  /// UTR / transaction id
  paymentRef    String?
  note          String?
  rejectReason  String?
  visitorId     String?
  ip            String?
  decidedAt     DateTime?
  decidedById   String?        @db.ObjectId
  decidedBy     Admin?         @relation(fields: [decidedById], references: [id])
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  instantTokens InstantToken[]

  @@index([status, createdAt])
  @@index([customerId])
  @@index([flipbookId])
  @@index([planId])
  @@index([decidedById])
}

model Flipbook {
  /// Our own random id (see services/ids.ts), also the uploads/<id>/ folder name.
  id            String          @id @map("_id")
  slug          String          @unique
  title         String
  showCover     Boolean         @default(true)
  pdfDownload   Boolean         @default(false)
  pageCount     Int
  pageWidth     Int
  pageHeight    Int
  /// JSON: [{ "clean": "x.webp", "marked": "y.webp", "w": 1400, "h": 1980 }]
  pages         String
  pdfFile       String?
  pdfName       String?
  ogFile        String?
  ogMarkedFile  String?
  /// Share link and preview use watermarked images
  watermarked   Boolean         @default(true)
  customerId    String?         @db.ObjectId
  customer      Customer?       @relation(fields: [customerId], references: [id], onDelete: SetNull)
  visitorId     String?
  linkExpiresAt DateTime
  disabled      Boolean         @default(false)
  filesDeleted  Boolean         @default(false)
  views         Int             @default(0)
  downloads     Int             @default(0)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  requests      Request[]
  downloadsLog  DownloadEvent[]
  instantTokens InstantToken[]

  @@index([visitorId])
  @@index([customerId])
  @@index([linkExpiresAt])
}

model DownloadEvent {
  id          String    @id @default(auto()) @map("_id") @db.ObjectId
  flipbookId  String?
  flipbook    Flipbook? @relation(fields: [flipbookId], references: [id], onDelete: SetNull)
  customerId  String?   @db.ObjectId
  customer    Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  visitorId   String?
  ip          String?
  /// free | plan | instant
  kind        String
  watermarked Boolean
  createdAt   DateTime  @default(now())

  @@index([visitorId, kind])
  @@index([ip, createdAt])
  @@index([createdAt])
  @@index([flipbookId])
  @@index([customerId])
}

model InstantToken {
  id         String    @id @default(auto()) @map("_id") @db.ObjectId
  token      String    @unique
  requestId  String    @db.ObjectId
  request    Request   @relation(fields: [requestId], references: [id], onDelete: Cascade)
  flipbookId String
  flipbook   Flipbook  @relation(fields: [flipbookId], references: [id], onDelete: Cascade)
  /// active | used | expired | revoked
  status     String    @default("active")
  expiresAt  DateTime
  usedAt     DateTime?
  usedIp     String?
  createdAt  DateTime  @default(now())

  @@index([requestId])
  @@index([flipbookId])
}

model Setting {
  key       String   @id @map("_id")
  /// JSON encoded
  value     String
  updatedAt DateTime @updatedAt
}

model AuditLog {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  adminId    String?  @db.ObjectId
  admin      Admin?   @relation(fields: [adminId], references: [id], onDelete: SetNull)
  actor      String
  action     String
  targetType String?
  targetId   String?
  details    String?
  ip         String?
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@index([adminId])
}

/// Written inside a transaction to make two transactions on the same key
/// collide (MongoDB then aborts one, and it is retried). Used so two free
/// downloads at the same moment can never both take the last free slot.
/// Old rows are removed by the daily job.
model Lock {
  key       String   @id @map("_id")
  n         Int      @default(0)
  updatedAt DateTime @updatedAt

  @@index([updatedAt])
}
