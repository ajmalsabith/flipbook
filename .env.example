# Copy this file to .env and fill in the values. Never commit .env.

# --- Server -------------------------------------------------------------
# Port the Node process listens on (Nginx proxies to it in production).
PORT=4000
# Public address of the site, used in share links, WhatsApp messages and
# Open Graph tags. No trailing slash.
# Development: http://localhost:5173   Production: https://amflipbook.amcloth.com
PUBLIC_URL=http://localhost:5173
# Number of reverse proxies in front of Node (1 for Nginx). Needed so rate
# limits and the per-IP free cap see the visitor's real IP.
TRUST_PROXY=1

# --- Secrets (generate each with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))")
JWT_SECRET=change-me-to-a-long-random-string
COOKIE_SECRET=change-me-to-another-long-random-string

# --- Storage ------------------------------------------------------------
# MongoDB connection string (Atlas). The database name in it (here "amflipbook")
# is the one used. Keep this secret.
DATABASE_URL=mongodb+srv://USER:PASSWORD@your-cluster.mongodb.net/amflipbook?retryWrites=true&w=majority
# Where page images, PDFs and preview cards are stored.
UPLOAD_DIR=./uploads
# Where `npm run backup` writes nightly archives.
BACKUP_DIR=./backups
# How many nightly backups to keep.
BACKUP_KEEP=14

# --- First admin (used by `npm run db:seed` only when no admin exists) ---
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-strong-password

# --- Defaults written to Settings by the seed (edit later in /admin) ------
# WhatsApp number that receives payment messages: country code + number, digits only.
ADMIN_WHATSAPP=919999999999

# --- Branding -----------------------------------------------------------
# Logo drawn in the corner of watermarked pages (SVG or PNG).
BRAND_LOGO_PATH=./web/public/brand/logo.svg
